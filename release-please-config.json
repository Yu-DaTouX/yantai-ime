{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "MetasequoiaImeWindows",
      "include-component-in-tag": false,
      "include-v-in-tag": true,
      "version-file": "version.txt",
      "draft": true,
      "prerelease": true,
      "force-tag-creation": true,
      "pull-request-header": "这个 PR 准备本分支的下一个版本。",
      "pull-request-footer": "CI 通过后 Release 工作流会自行合并这个 PR，然后构建并发布。手动合并效果相同，只是提前一个 run。没有配置签名证书时发布会产出带 -unsigned 后缀的未签名安装包，不会因此失败。"
    }
  }
}
